# Render -> Service -> Environment bölməsinə yazılır (açarları koda yazmayın)

# --- MƏCBURİ ---
PAY4BIT_PUBLIC_KEY=
PAY4BIT_SECRET_KEY=
PAY4BIT_CARD_PS=          # Pay4bit-də kart üçün ödəniş sisteminin ID-si
PAY4BIT_GOOGLE_PS=        # Google Pay üçün (istifadə etmirsinizsə boş)
PAY4BIT_APPLE_PS=         # Apple Pay üçün (istifadə etmirsinizsə boş)
FIREBASE_SERVICE_ACCOUNT_B64=   # ƏSAS layihənin (yevrolatotest) servis hesabı JSON-unun base64-ü
ALLOWED_ORIGINS=https://sizin-sayt.com,https://yevrolatotest.web.app   # vergüllə, boşluqsuz; sayt ünvanlarınız
SITE_URL=https://sizin-sayt.com

# --- İSTƏYƏ BAĞLI ---
FIREBASE_SERVICE_ACCOUNT_2_B64=  # 2-ci layihə (yevrolato2, kampaniya səbəti) servis hesabı base64
SUPER_ADMIN_UID=                 # boş qalsa koddakı UID işləyir
CAMPAIGN_START_ISO=
CAMPAIGN_END_ISO=
# BetaTransfer istifadə edirsinizsə
BETATRANSFER_PUBLIC_KEY=
BETATRANSFER_SECRET_KEY=
BETATRANSFER_PAYMENT_SYSTEM=
# Parol sıfırlama məktubu (Brevo) istifadə edirsinizsə
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=YevroLato
